{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/lead.ts": { "maxDuration": 20 }
  },
  "redirects": [
    { "source": "/financing", "destination": "/contact", "permanent": true },
    { "source": "/service-areas/maryland", "destination": "/service-areas", "permanent": true },
    { "source": "/service-areas/west-virginia", "destination": "/service-areas", "permanent": true },
    { "source": "/service-areas/pennsylvania", "destination": "/service-areas", "permanent": true },
    { "source": "/holiday", "destination": "/holiday-chimney-special", "permanent": false },
    { "source": "/199", "destination": "/holiday-chimney-special", "permanent": false },
    { "source": "/design", "destination": "/design-your-fireplace", "permanent": false },
    { "source": "/shop", "destination": "/fireplace-shop", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(media|brand|og|promo)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
